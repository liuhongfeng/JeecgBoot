<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.admin.ground.mapper.FcFishBoatMapper">

	<delete id="deleteByMainId" parameterType="java.lang.String">
		DELETE 
		FROM  fc_fish_boat 
		WHERE
			 ground_id = #{mainId} 	</delete>
	
	<select id="selectByMainId" parameterType="java.lang.String" resultType="org.jeecg.modules.admin.ground.entity.FcFishBoat">
		SELECT * 
		FROM  fc_fish_boat
		WHERE
			 ground_id = #{mainId} 	</select>
</mapper>
